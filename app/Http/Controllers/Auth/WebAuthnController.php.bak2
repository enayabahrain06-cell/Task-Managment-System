<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use App\Models\WebauthnCredential;
use App\Support\PostLoginRedirect;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use lbuchs\WebAuthn\Binary\ByteBuffer;
use lbuchs\WebAuthn\WebAuthn;
use lbuchs\WebAuthn\WebAuthnException;

class WebAuthnController extends Controller
{
    private function webauthn(): WebAuthn
    {
        return new WebAuthn(config('app.name', 'Task Manager'), request()->getHost(), null, true);
    }

    /**
     * Registration (auth required) — offer to enroll this device's Face ID / Touch ID /
     * fingerprint so the user can skip password/PIN entry on future visits from it.
     */
    public function registerOptions(Request $request): JsonResponse
    {
        $user = $request->user();
        $webauthn = $this->webauthn();

        $exclude = $user->webauthnCredentials()
            ->pluck('credential_id')
            ->map(fn (string $id) => ByteBuffer::fromBase64Url($id))
            ->all();

        $args = $webauthn->getCreateArgs(
            (string) $user->id,
            $user->email,
            $user->name,
            30,
            'required',   // resident/discoverable credential — needed for the usernameless login prompt
            'required',   // must be an actual biometric/device PIN, not just tapping a button
            false,        // platform authenticator only (Face ID / Touch ID / Windows Hello / fingerprint)
            $exclude
        );

        $request->session()->put('webauthn_register_challenge', $webauthn->getChallenge()->jsonSerialize());

        return response()->json($args);
    }

    public function register(Request $request): JsonResponse
    {
        $request->validate([
            'id'                => ['required', 'string'],
            'clientDataJSON'    => ['required', 'string'],
            'attestationObject' => ['required', 'string'],
            'label'             => ['nullable', 'string', 'max:60'],
        ]);

        $challenge = $request->session()->pull('webauthn_register_challenge');
        if (! $challenge) {
            return response()->json(['message' => 'Registration expired. Please try again.'], 422);
        }

        try {
            $webauthn = $this->webauthn();
            $data = $webauthn->processCreate(
                ByteBuffer::fromBase64Url((string) $request->input('clientDataJSON'))->getBinaryString(),
                ByteBuffer::fromBase64Url((string) $request->input('attestationObject'))->getBinaryString(),
                ByteBuffer::fromBase64Url((string) $challenge),
                true
            );
        } catch (WebAuthnException $e) {
            return response()->json(['message' => 'Could not verify this device: '.$e->getMessage()], 422);
        }

        $request->user()->webauthnCredentials()->create([
            'credential_id'      => (new ByteBuffer($data->credentialId))->jsonSerialize(),
            'public_key'         => $data->credentialPublicKey,
            'sign_count'         => $data->signatureCounter ?? 0,
            'attestation_format' => $data->attestationFormat,
            'device_label'       => $request->string('label')->trim()->value() ?: $this->guessDeviceLabel($request),
        ]);

        return response()->json(['message' => 'Biometric sign-in enabled for this device.']);
    }

    public function destroy(Request $request, WebauthnCredential $credential): JsonResponse
    {
        if ($credential->user_id !== $request->user()->id) {
            abort(403);
        }

        $credential->delete();

        return response()->json(['message' => 'Removed.']);
    }

    /** Guest-accessible: fetch a login challenge (no identity needed — discoverable credential flow). */
    public function loginOptions(Request $request): JsonResponse
    {
        $webauthn = $this->webauthn();
        $args = $webauthn->getGetArgs([], 30, false, false, false, true, true, 'required');

        $request->session()->put('webauthn_login_challenge', $webauthn->getChallenge()->jsonSerialize());

        return response()->json($args);
    }

    public function login(Request $request): JsonResponse
    {
        $request->validate([
            'id'                => ['required', 'string'],
            'clientDataJSON'    => ['required', 'string'],
            'authenticatorData' => ['required', 'string'],
            'signature'         => ['required', 'string'],
        ]);

        $challenge = $request->session()->pull('webauthn_login_challenge');
        if (! $challenge) {
            return response()->json(['state' => 'error', 'message' => 'Sign-in prompt expired. Please try again.'], 422);
        }

        $credential = WebauthnCredential::where('credential_id', (string) $request->input('id'))->first();
        if (! $credential) {
            return response()->json([
                'state'   => 'unregistered',
                'message' => "This device isn't set up for biometric sign-in here.",
            ], 422);
        }

        $user = $credential->user;
        if (! $user || $user->status !== 'active') {
            return response()->json([
                'state'   => 'inactive',
                'message' => 'This account can no longer sign in.',
            ], 422);
        }

        try {
            $webauthn = $this->webauthn();
            $webauthn->processGet(
                ByteBuffer::fromBase64Url((string) $request->input('clientDataJSON'))->getBinaryString(),
                ByteBuffer::fromBase64Url((string) $request->input('authenticatorData'))->getBinaryString(),
                ByteBuffer::fromBase64Url((string) $request->input('signature'))->getBinaryString(),
                $credential->public_key,
                ByteBuffer::fromBase64Url((string) $challenge),
                $credential->sign_count,
                true
            );
        } catch (WebAuthnException $e) {
            return response()->json(['state' => 'error', 'message' => 'Could not verify this device.'], 422);
        }

        $credential->update([
            'sign_count'   => $webauthn->getSignatureCounter() ?? $credential->sign_count,
            'last_used_at' => now(),
        ]);

        Auth::login($user);
        $request->session()->regenerate();

        return response()->json(['state' => 'ok', 'redirect' => PostLoginRedirect::url($user)]);
    }

    private function guessDeviceLabel(Request $request): string
    {
        $ua = (string) $request->userAgent();

        return match (true) {
            str_contains($ua, 'iPhone') => 'iPhone',
            str_contains($ua, 'iPad') => 'iPad',
            str_contains($ua, 'Android') => 'Android device',
            str_contains($ua, 'Macintosh') => 'Mac',
            str_contains($ua, 'Windows') => 'Windows PC',
            default => 'This device',
        };
    }
}
