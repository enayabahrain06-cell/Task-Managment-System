<div class="mfa-card" x-data="{useRecovery: false}">
    <div style="padding:36px 36px 28px;">

        {{-- Header --}}
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;">
            <div style="width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#4F46E5,#6366F1);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(79,70,229,0.35);">
                <i class="fas fa-shield-halved" style="color:#fff;font-size:18px;"></i>
            </div>
            <div>
                <h1 style="font-size:18px;font-weight:800;color:#111827;margin:0;">Two-Factor Authentication</h1>
                <p style="font-size:12px;color:#9CA3AF;margin:2px 0 0;"
