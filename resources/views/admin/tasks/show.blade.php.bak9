                            </div>
                            <span style="font-size:10px;font-weight:600;padding:1px 7px;border-radius:20px;color:#fff;"
                                  :style="'background:'+statusColor(r.status)"
                                  x-text="r.status.replace('_',' ')"></span>
                        </div>
