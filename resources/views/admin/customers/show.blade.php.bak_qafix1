    .app-main    { display:block !important; height:auto !important; overflow:visible !important; margin-left:0 !important; padding:0 !important; }
    main.app-content { overflow:visible !important; height:auto !important; flex:none !important; padding:0 !important; margin:0 !important; animation:none !important; }

    /* Suppress browser link-URL annotations (e.g. Firefox/Chrome default print behaviour) */
    a::after, a[href]::after { content:none !important; display:none !important; }

