$showLogo = '';
if (!empty($appSettings['logo_path'])) {
    $lp = Storage::disk('public')->path($appSettings['logo_path']);
    if (file_exists($lp)) {
        $mime = mime_content_type($lp) ?: 'image/jpeg';
        $showLogo = 'data:' . $mime . ';base64,' . base64_encode(file_get_contents($lp));
    }
}
