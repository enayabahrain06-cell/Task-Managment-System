                    </div>
                    <div class="scard-footer" x-data="{ testing:false, migrating:false, recovering:false, ok:null, msg:'', results:null }">
                        <div x-show="msg" style="flex:1;font-size:12px;font-weight:600;padding:6px 10px;border-radius:8px;display:flex;align-items:center;gap:6px;"
                             :style="ok ? 'background:#D1FAE5;color:#065F46;' : 'background:#FEE2E2;color:#991B1B;'">
                            <i :class="ok ? 'fas fa-circle-check' : 'fas fa-circle-xmark'" style="font-size:12px;"></i>
                            <span x-text="msg"></span>
                            <template x-if="results">
                                <span style="margin-left:6px;font-weight:400;opacity:.8;">
                                    (<span x-text="results.success"></span> moved,
                                    <span x-text="results.failed"></span> failed,
                                    <span x-text="results.skipped"></span> skipped)
                                </span>
                            </template>
                        </div>
                        <button type="button" @click="
                            testing=true; ok=null; msg=''; results=null;
                            fetch('{{ route('admin.settings.storage.test.omv') }}', {method:'POST',headers:{'X-CSRF-TOKEN':'{{ csrf_token() }}','Accept':'application/json'}})
                            .then(r=>r.json()).then(d=>{ok=d.ok;msg=d.message;}).catch(e=>{ok=false;msg='Request failed.'})
                            .finally(()=>testing=false)"
                            :disabled="testing || migrating"
                            style="padding:8px 16px;border:1.5px solid #E5E7EB;border-radius:9px;background:#fff;color:#374151;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:border-color .15s;"
                            onmouseover="this.style.borderColor='#6366F1'" onmouseout="this.style.borderColor='#E5E7EB'">
                            <i class="fas fa-plug" x-show="!testing" style="font-size:11px;color:#6366F1;"></i>
                            <i class="fas fa-spinner fa-spin" x-show="testing" style="font-size:11px;"></i>
                            <span x-text="testing ? 'Testing…' : 'Test Connection'">Test Connection</span>
                        </button>
                        <button type="button" @click="
                            if(!window.confirm('This will copy all local-only files to NAS and remove the local copies. Continue?')) return;
                            migrating=true; ok=null; msg=''; results=null;
                            fetch('{{ route('admin.settings.storage.migrate.nas') }}', {method:'POST',headers:{'X-CSRF-TOKEN':'{{ csrf_token() }}','Accept':'application/json'}})
                            .then(r=>r.json()).then(d=>{ok=d.ok;msg=d.message;results=d.results;}).catch(e=>{ok=false;msg='Request failed.'})
                            .finally(()=>migrating=false)"
                            :disabled="testing || migrating"
                            style="padding:8px 16px;border:1.5px solid #FDE68A;border-radius:9px;background:#FFFBEB;color:#92400E;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .15s;"
                            onmouseover="this.style.borderColor='#F59E0B';this.style.background='#FEF3C7'" onmouseout="this.style.borderColor='#FDE68A';this.style.background='#FFFBEB'">
                            <i class="fas fa-arrow-right-to-bracket" x-show="!migrating" style="font-size:11px;color:#D97706;"></i>
                            <i class="fas fa-spinner fa-spin" x-show="migrating" style="font-size:11px;"></i>
                            <span x-text="migrating ? 'Migrating…' : 'Migrate Local Files to NAS'">Migrate Local Files to NAS</span>
                        </button>
                        <button type="button" @click="
                            recovering=true; ok=null; msg=''; results=null;
                            fetch('{{ route('admin.settings.storage.recover.nas') }}', {method:'POST',headers:{'X-CSRF-TOKEN':'{{ csrf_token() }}','Accept':'application/json'}})
                            .then(r=>r.json()).then(d=>{ok=d.ok;msg=d.message;results={success:d.recovered,failed:d.notFound,skipped:0};}).catch(e=>{ok=false;msg='Request failed.'})
                            .finally(()=>recovering=false)"
                            :disabled="testing || migrating || recovering"
                            style="padding:8px 16px;border:1.5px solid #BFDBFE;border-radius:9px;background:#EFF6FF;color:#1D4ED8;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .15s;"
                            onmouseover="this.style.borderColor='#3B82F6';this.style.background='#DBEAFE'" onmouseout="this.style.borderColor='#BFDBFE';this.style.background='#EFF6FF'">
                            <i class="fas fa-rotate" x-show="!recovering" style="font-size:11px;color:#3B82F6;"></i>
                            <i class="fas fa-spinner fa-spin" x-show="recovering" style="font-size:11px;"></i>
                            <span x-text="recovering ? 'Scanning NAS…' : 'Recover NAS Paths'">Recover NAS Paths</span>
                        </button>
                        <button type="submit" class="sf-btn-primary"><i class="fas fa-save" style="margin-right:6px;"></i>Save NAS Settings</button>
                    </div>
                </form>
            </div>

