                                @foreach([
                                    ['key'=>'gmail',    'label'=>'Gmail',     'color'=>'#EA4335'],
                                    ['key'=>'outlook',  'label'=>'Outlook',   'color'=>'#0078D4'],
                                    ['key'=>'mailgun',  'label'=>'Mailgun',   'color'=>'#F06B35'],
                                    ['key'=>'sendgrid', 'label'=>'SendGrid',  'color'=>'#1A82E2'],
                                    ['key'=>'mailtrap', 'label'=>'Mailtrap',  'color'=>'#16A34A'],
